# Optional: copy to .env only to change these defaults. scripts/run_demo.py reads ./.env and passes it to
# both servers; a variable already set in your environment wins.
# No secrets here: AWS credentials come from "aws login" (or any standard AWS credential source).

# --- AWS ---
# Named AWS profile with Amazon Bedrock and Amazon Polly access (read by boto3); omit to use the default chain.
# AWS_PROFILE=evoca
# Region for Bedrock calls (the us.* cross-Region inference profiles).
BEDROCK_REGION=us-east-1
# Region for Polly (the hackathon project account is locked to eu-north-1; standard engine).
POLLY_REGION=eu-north-1
# Polly voice for the companion.
EVOCA_TTS_VOICE=Joanna

# --- Models ---
# Bedrock model id for the chat agent.
EVOCA_CHAT_MODEL=us.amazon.nova-2-lite-v1:0
# Sampling temperature for the chat agent.
EVOCA_CHAT_TEMPERATURE=0.3
# Bedrock model id for the archivist agent.
EVOCA_ARCHIVIST_MODEL=us.amazon.nova-2-lite-v1:0
# Sampling temperature for the archivist agent.
EVOCA_ARCHIVIST_TEMPERATURE=0.2

# --- Servers and data ---
# SQLite database (scripts/run_demo.py sets data/demo.db itself).
EVOCA_DB_PATH=data/evoca.db
# URL of the Evoca MCP server that both agents connect to.
EVOCA_MCP_URL=http://localhost:8000/mcp
# 1 enables the demo clock and /api/demo/* (scripts/run_demo.py sets it); leave empty in real use.
EVOCA_DEMO_MODE=
# Freeze "now" to a UTC ISO 8601 time, for demo recording and scheduler tests; empty = real time.
DEMO_NOW=
# faster-whisper model for speech-to-text (see docs/spike-results.md for the benchmark).
EVOCA_WHISPER_MODEL=small.en
# Cache folder for the Whisper model download (default data/hf-cache).
HF_HOME=data/hf-cache

# --- Evals (evals/run_evals.py) ---
# Bedrock model id that plays the elder.
EVOCA_EVAL_SIM_MODEL=us.amazon.nova-2-lite-v1:0
# Bedrock model id of the judge.
EVOCA_EVAL_JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Port for the MCP server the evals start.
EVOCA_EVAL_PORT=8010

# --- Web client (Vite reads this from web/.env, not from this file) ---
# Backend URL for the web client.
VITE_API_BASE_URL=http://localhost:8080
